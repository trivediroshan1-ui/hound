{
  "expo": {
    "name": "Hound",
    "slug": "hound",
    "scheme": "hound",
    "version": "0.11.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161826",
    "ios": {
      "bundleIdentifier": "app.hound.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Hound reads your steps, distance, heart rate and weight to score challenges with friends.",
        "NSHealthUpdateUsageDescription": "Hound does not write to Health, but iOS requires this description to be present.",
        "NSFaceIDUsageDescription": "Hound uses Face ID to unlock the app when you turn on App lock in Settings.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "app.hound.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false
        }
      ],
      "./plugins/withHealthConnect.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.304361422076-1eengk283vh6djddhs582frhiup7ersn"
        }
      ],
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Hound uses the camera to scan a friend's QR code so you can add them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-background-task",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "HoundGoals",
              "displayName": "Hound",
              "description": "Your hound and today's goals.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "contentMarginsDisabled": false
            },
            {
              "name": "HoundSteps",
              "displayName": "Hound steps",
              "description": "Today's steps toward your goal.",
              "supportedFamilies": ["accessoryCircular", "accessoryRectangular", "accessoryInline"],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HoundGoals",
              "label": "Hound",
              "description": "Your hound and today's goals.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5172900554113864~3767325277",
          "iosAppId": "ca-app-pub-5172900554113864~3364659733",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "844311e3-1bd2-4be3-85b1-a8b9c25196b0"
      }
    },
    "owner": "hound-challenge-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/844311e3-1bd2-4be3-85b1-a8b9c25196b0"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5172900554113864~3767325277",
    "ios_app_id": "ca-app-pub-5172900554113864~3364659733",
    "delay_app_measurement_init": true
  }
}
